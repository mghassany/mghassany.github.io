n <- 100
N <- 1000
theta <- 3
X <- runif(n*N,0,theta)
X <- matrix(X,N,n)
dim(X)
T1 = apply(X,1, function(x) { (2/n)*sum(x) })
T2 = apply(X,1, function(x) { sqrt((3/n)*sum(x^2)) })
T3 = apply(X,1, function(x) { ((4/n)*sum(x^3))^(1/3) })
T4 = apply(X,1, function(x) { ((3/(2*n)*sum(sqrt(x))))^2 })
T5 = apply(X,1, function(x) { ((1/(2*n))*sum(1/sqrt(x)))^(-2) })
T6 = apply(X,1, function(x) { exp(1)* (prod(x))^(1/n) })
T7 = apply(X,1, max)
T8 = ((n+1)/n)*apply(X,1, max)
T1
mean(T1)
theta-mean(T1)
T = cbind(T1,T2,T3,T4,T5,T6,T7,T8)
summary(T)
moyennes  = apply(T,2,mean)
variances = apply(T,2,var)
biais = moyennes - theta
risques = variances + biais^2
biais
min(biais)
which(min(biais))
risques = variances + biais^2
risques
min(risques)
which(biais == min(biais)) # ou bien sort() pour les ordonner
which(risques == min(risques))
# minimums
which(abs(biais) == min(abs(biais))) # ou bien sort() pour les ordonner
boxplot(data.frame(T))
abline(h=theta,col="red")
