lambda = 1.5
n = 10
N = 100
set.seed(123)
u = rexp(n*N,lambda)
sim = matrix(u,N,n )
T = apply(sim,1, function(x){length(x)/sum(x)})
b1 = function(x){
alpha=0.05
qchisq(alpha/2, 2*length(x))/(2*sum(x))
}
b2 = function(x){
alpha=0.05
qchisq(1-alpha/2, 2*length(x))/(2*sum(x))
}
IC99_b1 = apply(sim,1,b1)
IC99_b2 = apply(sim,1,b2)
erreur_inf = IC99_b1 > lambda
erreur_sup = IC99_b2 < lambda
sum(erreur_inf+erreur_sup) #nb d'IC faux
matplot(rbind(IC99_b1,IC99_b2),rbind(1:100,1:100),type="l",lty=1,col=ifelse(erreur_inf | erreur_sup, "red","blue"))
matpoints(T,1:100, pch=19,cex=0.5)
abline(v=lambda,col="red")
